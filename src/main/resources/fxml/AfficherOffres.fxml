<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="470.0" prefWidth="740.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.AfficherOffresController">

    <children>
        <!-- Titre -->
        <Label layoutX="30.0" layoutY="20.0" styleClass="label-title" text="Gestion des promotions" textFill="#201515">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Bouton de bascule vers l'interface client -->
        <Button fx:id="btnSwitch" layoutX="330.0" layoutY="21.0" mnemonicParsing="false" onAction="#handleSwitchToClient" styleClass="btn-update" text="Interface Voyageur ✈️" textFill="#181717" />

        <!-- Barre de recherche -->
        <TextField fx:id="txtRecherche" layoutX="532.0" layoutY="21.0" prefHeight="32.0" prefWidth="150.0" promptText="Rechercher une offre par titre" />

        <!-- Tableau des offres -->
        <TableView fx:id="tableOffres" layoutX="30.0" layoutY="61.0" prefHeight="360" prefWidth="660">
            <columns>
                <TableColumn fx:id="colId" text="ID" />
                <TableColumn fx:id="colTitre" text="Titre" />
                <TableColumn fx:id="colRemise" text="Remise (%)" />
                <TableColumn fx:id="colStatut" prefWidth="76.79998779296875" text="Statut" />
                <TableColumn fx:id="colODD" prefWidth="125.5999755859375" text="Impact ODD 8" />
            </columns>
        </TableView>

        <!-- Boutons de gestion en bas -->

        <!-- NOUVEAU BOUTON : Gérer les Coupons -->
        <Button fx:id="btnGererCodes" layoutX="240.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleGererCodes" styleClass="btn-update" text="Gérer les Coupons 🎟️" textFill="#181717" />

        <Button fx:id="btnSuppprimer" layoutX="402.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleSupprimer" styleClass="btn-delete" text="Supprimer" textFill="#151414" />
        <Button fx:id="btnModifier" layoutX="491.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleModifier" styleClass="btn-update" text="Modifier l'Offre" textFill="#181717" />
        <Button fx:id="btnAjouter" layoutX="609.0" layoutY="430.0" mnemonicParsing="false" onAction="#handleAjouter" styleClass="btn-add" text=" + Créer une Offre" textFill="#181717" />
    </children>

</AnchorPane>